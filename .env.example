# ── Database ──────────────────────────────────────────────────────────────────
# Set by docker-compose automatically; override only for external DB
DATABASE_URL=mysql://emr:changeme@db:3306/cloud_emr

# MySQL credentials (used by docker-compose to initialise the db container)
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_PASSWORD=changeme

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random secret for signing JWT session cookies — use: openssl rand -hex 32
JWT_SECRET=replace_with_64_hex_chars

# First-run admin account created automatically on server start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login

# ── LLM (Medical Intake AI) ───────────────────────────────────────────────────
# Provider selection: "bedrock" (Claude on AWS Bedrock) or "openai" (any
# OpenAI-compatible endpoint, configured via BUILT_IN_FORGE_* below).
LLM_PROVIDER=bedrock

# -- Bedrock provider (LLM_PROVIDER=bedrock) --
# Bedrock API key (bearer token). Generate in AWS Console > Bedrock > API keys.
AWS_BEARER_TOKEN_BEDROCK=replace_with_bedrock_api_key
AWS_REGION=us-west-2
# Claude Haiku 4.5 via the global endpoint (no regional premium). For
# US-data-residency routing use us.anthropic.claude-haiku-4-5-20251001-v1:0.
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# -- OpenAI-compatible provider (LLM_PROVIDER=openai) --
# Point at any OpenAI-compatible endpoint.
# Examples:
#   OpenAI:        https://api.openai.com    + sk-...
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai  + AIza...
#   Ollama (local): http://ollama:11434/v1   + ollama (any non-empty string)
BUILT_IN_FORGE_API_URL=https://api.openai.com
BUILT_IN_FORGE_API_KEY=sk-replace_me

# ── Optional ──────────────────────────────────────────────────────────────────
PORT=3000
